    "db:generate": "drizzle-kit generate",
    "db:seed": "tsx server/scripts/seed-from-csv.ts",
    "db:verify": "tsx server/scripts/verify-migration.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "cross-env NODE_ENV=production PORT=5180 tsx server/index.ts",
    "share": "cross-env NODE_ENV=production PORT=5180 TUNNEL_MODE=true tsx server/index.ts",
    "dev:legacy": "vite --config vite.legacy.config.js",
    "lint:tokens": "node scripts/check-tokens.mjs",
    "prebuild": "node scripts/check-tokens.mjs"
  },
