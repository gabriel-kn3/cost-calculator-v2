{
  "name": "cost-calculator-v2",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_ENV=development PORT=5180 tsx watch server/index.ts",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "check": "tsc --noEmit",
    "baseline:generate": "node tests/characterization/generate-baseline.mjs",
    "test:math": "tsx tests/characterization/verify-port.ts",
    "db:generate": "drizzle-kit generate",
    "db:seed": "tsx server/scripts/seed-from-csv.ts",
    "db:verify": "tsx server/scripts/verify-migration.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:vite-only": "vite",
    "start": "cross-env NODE_ENV=production PORT=5180 tsx server/index.ts",
    "share": "cross-env NODE_ENV=production PORT=5180 TUNNEL_MODE=true tsx server/index.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.0",
    "better-sqlite3": "^12.11.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "grommet": "^2.52.0",
    "grommet-icons": "^4.14.0",
    "helmet": "^8.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.12.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^7.2.4",
    "vitest": "^5.0.0"
  }
}
